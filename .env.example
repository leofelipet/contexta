APP_ENV=development
DATABASE_URL=postgres://contexta:contexta@localhost:5435/contexta?sslmode=disable
POSTGRES_PORT=5435
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s
BACKEND_PORT=8082

API_BEARER_TOKEN=replace-with-at-least-32-random-characters
MCP_BEARER_TOKEN=replace-with-another-at-least-32-character-token

UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_TOKEN=replace-with-your-instance-token
UAZAPI_INSTANCE_ID=replace-with-your-instance-id
UAZAPI_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
UAZAPI_WEBHOOK_PUBLIC_URL=https://example.com/webhooks/uazapi
UAZAPI_CAPTURE_DIR=

MCP_ENABLED=true
SCHEDULER_ENABLED=true

TRANSCRIPTION_ENABLED=false
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_LANGUAGE=pt

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Base64-encoded 32-byte AES key for email account passwords at rest.
# Generate: openssl rand -base64 32
EMAIL_CREDENTIALS_KEY=
